# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local
.env

# WSL + op.exe ローカル起動補助（WSLENV 定義、秘密なし・環境依存）
/.wslenv.env

# playwright-cli の出力（スナップショット・ログ）
/.playwright-cli/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated images (local storage)
/public/images/generated/

# review status
/status/
